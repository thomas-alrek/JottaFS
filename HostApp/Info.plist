<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>JottaFS</string>
	<!-- Starts without a Dock icon, so a launch at login (by the
	     no.alrek.jottafs.login agent) never shows one. Every other launch
	     switches to a normal Dock app at once (AppDelegate
	     applicationWillFinishLaunching). -->
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
