      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Første plassering"
          }
        }
      }
    },
    "Folders shared with others" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapper som er delt med andre"
          }
        }
      }
    },
    "If you’d rather not sign in through the browser." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du ikke vil logge inn via nettleseren."
          }
        }
      }
    },
    "In the backup device “%@”." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup-enheten «%@»."
          }
        }
      }
    },
    "Installing JottaFS %@…" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerer JottaFS %@…"
          }
        }
      }
    },
    "It is the last location in “%@”: the backup device stays in Jottacloud without locations and no longer shows here. To remove the backup device too, use Delete Backup Device instead." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er den siste plasseringen i «%@»: backup-enheten blir værende i Jottacloud uten plasseringer og vises ikke lenger her. Bruk «Slett backup-enheten» i stedet for å fjerne backup-enheten også."
          }
        }
      }
    },
    "It is unmounted first." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den deaktiveres først."
          }
        }
      }
    },
    "It will be removed from Finder. Your files stay in Jottacloud. Close any files you have open from it first." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den blir fjernet fra Finder. Filene dine blir værende i Jottacloud. Lukk først alle filer du har åpne fra den."
          }
        }
      }
    },
    "JottaFS %@ couldn’t be installed." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS %@ kunne ikke installeres."
          }
        }
      }
    },
    "JottaFS %@ is available." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS %@ er tilgjengelig."
          }
        }
      }
    },
    "JottaFS can mount Jottacloud locations as disks in Finder." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS kan aktivere Jottacloud-plasseringer som disker i Finder."
          }
        }
      }
    },
    "JottaFS can’t reach Jottacloud." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS får ikke kontakt med Jottacloud."
          }
        }
      }
    },
    "JottaFS could not disconnect Jottacloud. Try again, or restart your Mac." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS kunne ikke koble fra Jottacloud. Prøv igjen, eller start Mac-en på nytt."
          }
        }
      }
    },
    "JottaFS could not prepare the sign-in. Try again." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS kunne ikke klargjøre innloggingen. Prøv igjen."
          }
        }
      }
    },
    "JottaFS couldn’t clear the cache." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS kunne ikke tømme bufferen."
          }
        }
      }
    },
    "JottaFS couldn’t load your Jottacloud locations." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS kunne ikke laste inn Jottacloud-plasseringene dine."
          }
        }
