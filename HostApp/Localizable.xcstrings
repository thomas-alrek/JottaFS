          }
        }
      }
    },
    "JottaFS couldn’t sign you in." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS kunne ikke logge deg inn."
          }
        }
