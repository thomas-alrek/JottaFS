    },
    "JottaFS couldn’t turn on mounting at login." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS kunne ikke slå på aktivering ved pålogging."
          }
        }
      }
    },
    "JottaFS couldn’t unmount the location." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS kunne ikke deaktivere plasseringen."
          }
        }
      }
    },
    "JottaFS keeps recently downloaded file data on your Mac, so files you open again open immediately. When the cache is full, the oldest data is removed. A disk’s data is removed when you unmount it, and all of it when you restart your Mac." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS beholder nylig nedlastede fildata på Mac-en, slik at filer du åpner igjen, åpnes med en gang. Når bufferen er full, fjernes de eldste dataene. Dataene for en disk fjernes når du deaktiverer den, og alle data fjernes når du starter Mac-en på nytt."
          }
        }
      }
    },
    "JottaFS opens again when it’s done." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS åpnes igjen når den er ferdig."
          }
        }
      }
    },
    "Jottacloud didn’t accept the sign-in. Please try again." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jottacloud godtok ikke innloggingen. Prøv igjen."
          }
        }
      }
    },
