      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS kunne ikke lagre innstillingen."
          }
        }
      }
    },
    "JottaFS couldn’t sign out because Jottacloud is still mounted." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JottaFS kunne ikke logge ut fordi Jottacloud fortsatt er aktivert."
          }
        }
      }
    },
    "JottaFS couldn’t sign out." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
