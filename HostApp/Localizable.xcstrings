{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ of %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ av %2$@"
          }
        }
      }
    },
    "%@ of %@ used" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@ used"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ av %2$@ brukt"
          }
        }
      }
    },
    "%@ · Backup from %@" : {
      "comment" : "A backed-up folder and the computer it is backed up from",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · Backup from %2$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · Backup fra %2$@"
          }
        }
      }
    },
    "A backup device holds locations that you can mount, like the backup of a computer. It shows under Backup on jottacloud.com." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En backup-enhet inneholder plasseringer som du kan aktivere, på samme måte som backupen av en datamaskin. Den vises under Backup på jottacloud.com."
          }
        }
      }
    },
    "A token works once. After that, JottaFS keeps you signed in, so you don’t need to keep the token." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et token virker bare én gang. Etterpå holder JottaFS deg innlogget, så du trenger ikke ta vare på tokenet."
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til"
          }
        }
      }
    },
    "Add a backup device, or a location to the selected backup device" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en backup-enhet, eller en plassering i den valgte backup-enheten"
