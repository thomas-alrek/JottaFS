    "Files synced with your devices" : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer som synkroniseres med enhetene dine"
          }
        }
      }
    },
    "Files you open again are downloaded from Jottacloud again. Your files in Jottacloud are not changed." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer du åpner igjen, lastes ned fra Jottacloud på nytt. Filene dine i Jottacloud blir ikke endret."
          }
        }
      }
    },
